# Copy this file to .streamlit/secrets.toml and fill in the real values.
# secrets.toml is gitignored; never commit it.
#
# Supabase: use the session pooler (IPv4) connection string from
# Dashboard -> Project Settings -> Database -> Connection string.
DATABASE_URL = "postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# Only needed for supabase_client.py (Storage / Auth / Realtime / PostgREST).
# App data goes through DATABASE_URL above via database.py -- these are not
# required for that. From Dashboard -> Project Settings -> API.
SUPABASE_URL = "https://<project-ref>.supabase.co"
SUPABASE_KEY = "<anon-or-service-role-key>"
