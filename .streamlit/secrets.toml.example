# Copy this file to .streamlit/secrets.toml and fill in the real connection
# string. secrets.toml is gitignored and must never be committed.
#
# Supabase → Project Settings → Database → Connection string → URI.
# Encode reserved characters in the password: "@" becomes "%40".
#
# Use the transaction pooler on port 6543 for this app. It opens and closes a
# transaction per query, which the transaction pooler multiplexes far more
# efficiently than the session pooler on 5432.
#
# Connect as a least-privilege application role, not as `postgres`. The
# `postgres` role carries the BYPASSRLS attribute, which silently disables
# every row-level security policy this app installs.
# See scripts/create_app_role.sql.

DATABASE_URL = "postgresql://nualco_app.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?sslmode=require"
